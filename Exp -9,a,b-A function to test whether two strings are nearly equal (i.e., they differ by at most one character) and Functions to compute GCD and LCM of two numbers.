def are_nearly_equal(s1, s2):
    if abs(len(s1) - len(s2)) > 1:
        return False

    # Make sure s1 is the shorter one
    if len(s1) > len(s2):
        s1, s2 = s2, s1

    i = j = diff = 0
    while i < len(s1) and j < len(s2):
        if s1[i] != s2[j]:
            diff += 1
            if diff > 1:
                return False
            if len(s1) != len(s2):
                j += 1
                continue
        i += 1
        j += 1

    # Account for extra character at the end
    if j < len(s2):
        diff += 1

    return diff <= 1


