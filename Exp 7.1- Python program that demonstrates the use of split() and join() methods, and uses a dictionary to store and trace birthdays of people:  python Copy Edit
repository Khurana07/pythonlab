# Creating a dictionary to store birthdays
birthdays = {
    "Alice": "1990-05-12",
    "Bob": "1985-11-23",
    "Charlie": "2000-01-17"
}

# Ask user to enter a name
name = input("Enter a name to find the birthday: ")

# Check if the name exists in the dictionary
if name in birthdays:
    # Get the birthday and use split() to separate year, month, day
    bday = birthdays[name]
    parts = bday.split("-")  # Split by hyphen
    print(f"{name}'s birthday is on: {bday}")
    print("Year:", parts[0])
    print("Month:", parts[1])
    print("Day:", parts[2])

    # Rejoin with a more readable format
    readable_format = "/".join(parts)
    print("Birthday in readable format (DD/MM/YYYY):", f"{parts[2]}/{parts[1]}/{parts[0]}")
else:
    print("Sorry, birthday not found.")
