def sum_even_fibonacci(limit):
    a, b = 1, 2
    total = 0

    while a <= limit:
        if a % 2 == 0:
            total += a
        a, b = b, a + b

    return total

# Set the limit
limit = 4_000_000
result = sum_even_fibonacci(limit)
print(f"Sum of even Fibonacci numbers not exceeding {limit} is: {result}")
